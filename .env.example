# Kopiere diese Datei zu ".env" und trage deine echten Keys ein.
# Die .env-Datei wird NIEMALS committet (siehe .gitignore).

# Anthropic (Claude) – Pflicht für alle Text-Agents
ANTHROPIC_API_KEY=sk-ant-...

# fal.ai – nur nötig für den Video-Producer (Phase 3, echtes Rendern)
FAL_KEY=...

# ---------------------------------------------------------------------------
# Phase 2: Auto-Posting (nur für `python publish.py --live` nötig).
# Der Dry-Run läuft ganz ohne diese Werte.
# ---------------------------------------------------------------------------

# X (Twitter) API v2 – OAuth 1.0a User-Context (App im Developer-Portal anlegen)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Meta Graph – Facebook-Seite
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Meta Graph – Instagram-Business-Konto (mit FB-Seite verknüpft)
IG_USER_ID=
IG_ACCESS_TOKEN=

# YouTube Data API v3 – OAuth2 (Client + Refresh-Token mit youtube.upload-Scope)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Monitoring: YouTube Data API v3 – nur API-Key (für öffentliche Video-Stats,
# kein OAuth nötig). In der Google Cloud Console erstellen.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
